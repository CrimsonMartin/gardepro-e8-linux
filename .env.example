# Copy to .env and fill in your own camera.
#
# The camera advertises over Bluetooth LE as CAM<something>_NoName_G_<model>.
# Find its MAC with the camera powered on and nearby:
#
#   bluetoothctl --timeout 20 scan le | grep -i CAM
#
# Example output:
#   Device AA:BB:CC:DD:EE:FF CAM8Z8_NoName_G_E8
#
# The wifi hotspot name is derived from this automatically: the model prefix
# plus the MAC with colons stripped, e.g. CAM8Z8_AABBCCDDEEFF.
GARDECAM_BLE_MAC=AA:BB:CC:DD:EE:FF
# More than one camera? List them all, comma separated. `sync` visits each in
# turn and downloads into the same media directory with the file names
# prefixed cam1_, cam2_, ... in list order (keep the order stable!); the other
# commands use the first one listed.
#GARDECAM_BLE_MAC=AA:BB:CC:DD:EE:F1,AA:BB:CC:DD:EE:F2

# Wireless interface used to join the camera hotspot.
# Linux: see `ip link`. macOS: usually en0, see
# `networksetup -listallhardwareports`. Leave unset to take the default for
# the platform (en0 on macOS, wlp0s20f3 on Linux).
#GARDECAM_IFACE=wlan0

# macOS only. CoreBluetooth hides the camera's MAC behind a UUID that is
# specific to this Mac, so the MAC above names the hotspot but cannot find the
# camera. By default any device advertising a name starting GARDECAM_BLE_NAME
# is taken to be it, which is enough for a single camera. With several in
# range, pin this Mac's UUID for the one you want - `gardecam.py scan` lists
# them.
#GARDECAM_BLE_UUID=
#GARDECAM_BLE_NAME=CAM

# Factory default on these cameras; only change it if you set your own.
#GARDECAM_WIFI_PASS=1234567890

# Where downloads are written. Defaults to ./media next to the script.
#GARDECAM_MEDIA=/path/to/media

# Days of raw clips to keep. `sync` deletes older ones from the top level of
# the media directory once it has finished; annotated clips, their stills and
# the sidecars are never touched, so Immich and the notifications keep working.
# Raw footage runs to about a gigabyte a day on a busy camera, so leaving this
# unbounded fills a laptop in a few months. 0 disables pruning entirely.
#GARDECAM_KEEP_DAYS=14

# Optional, for wildlife.py: 3-letter country code (e.g. USA) passed to
# SpeciesNet geofencing so species rollups favor animals found in your region.
#GARDECAM_COUNTRY=USA

# Optional, for wildlife.py --remote: an ssh host with docker (ideally with an
# NVIDIA GPU) to run scans on, and the directory used there (default
# gardecam-wildlife in that machine's home).
#GARDECAM_REMOTE=gpubox
#GARDECAM_REMOTE_DIR=gardecam-wildlife

# autosync.py (hourly timer): push notifications for new wildlife clips via a
# self-hosted ntfy server. Pick a long random topic name - it is the secret.
#GARDECAM_NTFY_URL=http://ntfy-host:8090/gardecam-<random>
# Your Immich server. With a read-only (asset.read) API key a tap on each
# notification deep-links the clip in the Immich mobile app.
#GARDECAM_IMMICH_URL=http://immich-host:2283/
#GARDECAM_IMMICH_API_KEY=
# Per-clip notifications per pass before they collapse into one summary.
#GARDECAM_NOTIFY_MAX=5
