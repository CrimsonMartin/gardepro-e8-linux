# Image for wildlife.py: MegaDetector + SpeciesNet (google/cameratrapai), CPU.
# Built automatically by wildlife.py on first run:
#   docker build -t gardecam-wildlife -f Dockerfile.wildlife .
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch wheels keep the image a fraction of the CUDA size; a GPU
# build (wildlife.py picks this automatically when nvidia-smi is present)
# overrides the index so pip resolves the default CUDA torch wheels instead.
ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir \
    --extra-index-url ${TORCH_INDEX} \
    speciesnet opencv-python-headless
